const SHEET_NAME = '미분8문항_응답';
function doGet(){return ContentService.createTextOutput('미분 8문항 퀴즈 제출 시스템 정상 작동').setMimeType(ContentService.MimeType.TEXT);}
function doPost(e){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName(SHEET_NAME);if(!sh)sh=ss.insertSheet(SHEET_NAME);const headers=['서버 제출시각','학번','이름','점수','정답수','정오표','1번 답안','1번 O/X','2번 답안','2번 O/X','3번 답안','3번 O/X','4번 답안','4번 O/X','5번 답안','5번 O/X','6번 답안','6번 O/X','7번 답안','7번 O/X','8번 답안','8번 O/X','학생 기기 제출시각','페이지 주소','제출 ID'];if(sh.getLastRow()===0){sh.appendRow(headers);sh.getRange(1,1,1,headers.length).setFontWeight('bold');sh.setFrozenRows(1);}const p=e.parameter||{};const sid=String(p.submissionId||'');if(sid&&sh.getLastRow()>=2){const vals=sh.getRange(2,25,sh.getLastRow()-1,1).getDisplayValues().flat();if(vals.includes(sid))return out_({ok:true,duplicate:true});}sh.appendRow([new Date(),p.studentId||'',p.studentName||'',p.score||'',p.correctCount||'',p.answerPattern||'',p.q1Answer||'',p.q1Result||'',p.q2Answer||'',p.q2Result||'',p.q3Answer||'',p.q3Result||'',p.q4Answer||'',p.q4Result||'',p.q5Answer||'',p.q5Result||'',p.q6Answer||'',p.q6Result||'',p.q7Answer||'',p.q7Result||'',p.q8Answer||'',p.q8Result||'',p.clientSubmittedAt||'',p.pageUrl||'',sid]);return out_({ok:true});}catch(err){return out_({ok:false,error:String(err)});}finally{lock.releaseLock();}}
function out_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
